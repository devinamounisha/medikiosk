# ==============================================================================
# MEDIKIOSK ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API Configuration
PORT=5000
NODE_ENV=development

# Supabase (PostgreSQL & Storage)
# If left empty, backend and frontend automatically operate in local mock/resilient mode
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Groq AI Configuration (Configurable OpenAI-compatible interface)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Frontend Environment (Vite)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
